# uefi.orum — UEFI calling convention helper for Orum.
# Provides uefi_call() which converts System V to MS x64.
# All UEFI firmware functions are called through this.

# uefi_call(fn_ptr, a1, a2, a3, a4) -> status
# System V in: RDI=fn_ptr, RSI=a1, RDX=a2, RCX=a3, R8=a4
# MS x64 out: RCX=a1, RDX=a2, R8=a3, R9=a4, call fn_ptr
fn uefi_call(fn_ptr: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> u64
  mut ret: u64 = 0
  asm
    in fn_ptr = rdi
    in a1 = rsi
    in a2 = rdx
    in a3 = rcx
    in a4 = r8
    out ret = rax
    clobber "r9"
    clobber "r10"
    clobber "r11"
    raw 0x4D, 0x89, 0xC1  # mov r9, r8   (a4 -> R9)
    raw 0x49, 0x89, 0xC8  # mov r8, rcx  (a3 -> R8)
    raw 0x48, 0x89, 0xF1  # mov rcx, rsi (a1 -> RCX)
    # rdx already = a2
    raw 0x48, 0x83, 0xEC, 0x20  # sub rsp, 32 (shadow)
    raw 0xFF, 0xD7              # call rdi
    raw 0x48, 0x83, 0xC4, 0x20  # add rsp, 32
  end
  return ret
end
