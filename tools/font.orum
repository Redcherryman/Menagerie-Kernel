# font.orum — Menagerie console font as Orum data (build-tool copy).
#
# Ported from boot/font_data.py build_font(). 54 hand-drawn 8x16
# glyphs (original designs, no font IP) + 128-byte ASCII->glyph
# index table (0xFF = no glyph). GLYPH_ORDER[0] is '?' so the
# kernel can use index 0 as the unknown-character fallback.
#
# Declarations only: safe to `take` from any tool. All data lives
# in function-local array literals (module constants aren't visible
# inside fn bodies).

fn font_glyph_count() -> u64
return 54
end

fn font_glyph_bytes() -> u64
return 16
end

